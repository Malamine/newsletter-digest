# Copie ce fichier en .env pour le dev local (jamais commité).
# En prod (Cloud Run), ces valeurs viennent de Secret Manager / variables d'env du service.

# GCP
GCP_PROJECT_ID=your-gcp-project-id

# Gemini (clé API gratuite sur https://aistudio.google.com/apikey)
GEMINI_API_KEY=
MODEL_CURATION=gemini-2.5-flash
MODEL_CONSEIL=gemini-2.5-flash
MODEL_QUIZ=gemini-2.5-flash

# Gmail (boîte dédiée, label NEWSLETTER) — voir scripts/gmail-get-refresh-token.js
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_LABEL=NEWSLETTER

# Web Push (VAPID) — voir scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:you@example.com

PORT=8080
